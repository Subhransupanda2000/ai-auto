# Base URL for API calls. Left as "/api" by default so the Vite dev server
# proxy (see vite.config.ts) forwards requests to the Spring Boot backend
# at http://localhost:8081, avoiding CORS configuration in development.
# In production, set this to the fully-qualified backend URL, e.g.
# https://api.yourclinic.com/api
VITE_API_BASE_URL=/api

# Application display name used in the app bar / title.
VITE_APP_NAME=HealthcareAI Console
