# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=root
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/healthcareaii

# --- Server ---
SERVER_PORT=8080
LOG_LEVEL=INFO

# --- JWT ---
JWT_SECRET=change-me-in-production-to-a-long-random-secret-value
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# --- Clinic business config ---
CLINIC_NAME=Healthcare Clinic
CLINIC_TIMEZONE=UTC
CLINIC_WORKING_HOURS_START=09:00
CLINIC_WORKING_HOURS_END=17:00
APPOINTMENT_SLOT_MINUTES=30
REMINDER_HOURS_BEFORE=24
ESCALATION_EMAIL=
ESCALATION_PHONE_NUMBER=

# --- CORS ---
CORS_ALLOWED_ORIGINS=

# --- AI provider: Google Gemini (REST API, no SDK) ---
GEMINI_API_KEY=
# "gemini-flash-latest" is a stable alias; pinned versions like
# "gemini-2.5-flash"/"gemini-2.5-flash-lite" may return HTTP 404 "no longer
# available to new users" depending on your API key/project. Run
#   GET https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY
# to see which concrete models your key currently supports.
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TEMPERATURE=0.2
# gemini-embedding-001 supports Matryoshka truncation to 768/1536/3072;
# 1536 matches the existing faq_documents.embedding vector(1536) column
# (see V7__create_faq_documents_table.sql) so no migration is needed.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# --- Twilio SMS ---
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- WhatsApp Business Cloud API ---
WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Google Calendar ---
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_APP_NAME=HealthcareAI
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_KEY_PATH=

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- n8n workflow automation ---
N8N_ENABLED=false
N8N_WEBHOOK_BASE_URL=
N8N_INBOUND_WEBHOOK_SECRET=
